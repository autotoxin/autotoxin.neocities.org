---
// components
import Changelog from "../components/changelog.astro";
import ToDo from "../components/to-do.astro";
import UnderConstruction from "../components/under-construction.astro";
import StandardLayout from "./standard-layout.astro";

interface Props {
    frontmatter: {
        title?: string;
        siteTitle?: string;
        description?: string;
    };
    children: unknown;
}

const props = Astro.props;
---

<StandardLayout {...props}>
    <article class="bg-background rounded-pixelated-8 min-h-0 shrink-0 p-5">
        <slot />
    </article>
    <UnderConstruction class="rounded-pixelated-8 min-h-20 grow" />
    <div class="grid min-h-0 grid-cols-3 gap-4">
        <Changelog class="bg-background rounded-pixelated-6 col-span-2 min-h-0 px-5 py-3" />
        <ToDo class="bg-background rounded-pixelated-6 min-h-0 px-5 py-3" />
    </div>
</StandardLayout>
