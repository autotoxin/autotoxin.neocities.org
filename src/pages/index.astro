---
// styles
import "../styles/global.css";
import "../styles/pages/index.css";

// components
import UnderConstruction from "../components/under-construction.astro";
import Badges from "../components/badges.astro";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>AutotoxiN</title>
        <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <meta name="apple-mobile-web-app-title" content="AutotoxiN" />
        <link rel="manifest" href="/site.webmanifest" />
    </head>
    <body>
        <div class="background"></div>
        <div class="relative flex min-h-screen w-full items-center justify-center">
            <main class="grid grid-cols-3 gap-4">
                <div class="col-span-2 flex flex-col justify-start gap-4">
                    <div class="bg-background rounded-pixelated-4 p-5">
                        <UnderConstruction />
                    </div>
                    <div class="bg-background rounded-pixelated-4 grow p-5"></div>
                    <footer>
                        <Badges />
                    </footer>
                </div>
                <div class="flex flex-col justify-start gap-4">
                    <header class="bg-background rounded-pixelated-4 p-5">
                        <h1 class="font-title text-primary text-title cursor-default text-center select-none">
                            AutotoxiN
                        </h1>
                    </header>
                    <aside class="bg-background rounded-pixelated-4 grow p-5"></aside>
                </div>
            </main>
        </div>
    </body>
</html>
