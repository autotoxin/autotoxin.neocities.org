---
/**
 * TO DO: Make a generic badge component and store data in maybe json
 */

// styles
import "../styles/features/badges-section.css";

// components
import BadgeResolution from "./badges/badge-resolution.astro";
import BadgeAstro from "./badges/badge-astro.astro";
import BadgeValidHtml from "./badges/badge-valid-html.astro";
import BadgeOfflineVersion from "./badges/badge-offline-version.astro";
import BadgeMadeWithMacos from "./badges/badge-made-with-macos.astro";
import BadgeLicense from "./badges/badge-license.astro";
import BadgeNoFrames from "./badges/badge-no-frames.astro";

// utils
import { cn } from "../utils/cn";

interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn("badges-container", className)} role="complementary">
    <slot>
        <BadgeResolution />
        <BadgeAstro />
        <BadgeValidHtml />
        <BadgeOfflineVersion />
        <BadgeMadeWithMacos />
        <BadgeLicense />
        <BadgeNoFrames />
    </slot>
</div>
