---
// styles
import "../styles/features/to-do.css";

// content
import { compiledContent } from "../content/todo.md";

// utils
import { cn } from "../utils/cn";
import { markdownTasklistA11y } from "../utils/markdown-tasklist-a11y";

interface Props {
    class?: string;
}

const { class: className } = Astro.props;
const accessibleContent = markdownTasklistA11y(await compiledContent());
---

<section class={cn("to-do flex flex-col justify-start gap-2", className)}>
    <h3 class="min-h-0 text-center text-xl leading-none">To-do</h3>
    <div id="to-do-content" class="min-h-0 overflow-auto overscroll-y-contain" set:html={accessibleContent} />
</section>
