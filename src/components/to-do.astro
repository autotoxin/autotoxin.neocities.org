---
import "../styles/features/to-do.css";
import { Content } from "../content/todo.md";
import { cn } from "../utils/cn";

interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn("to-do flex flex-col justify-start gap-1", className)}>
    <h3 class="text-center text-xl leading-none">To-do</h3>
    <Content />
</div>
