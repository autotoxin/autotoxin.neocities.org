---
import "../styles/features/to-do.css";
import { Content } from "../content/todo.md";
import { cn } from "../utils/cn";

interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn("to-do flex flex-col justify-start gap-2", className)} role="marquee">
    <h3 class="min-h-0 text-center text-xl leading-none">To-do</h3>
    <div class="min-h-0 overflow-auto overscroll-y-contain"><Content /></div>
</div>
