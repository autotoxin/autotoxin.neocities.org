---
// styles
import "../styles/features/under-construction.css";

// utils
import { cn } from "../utils/cn";

interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<section class={cn("construction-container rounded-pixelated-2", className)}>
    <div class="construction-bg-overlay"></div>
    <div class="construction-label">
        <span class="text1">Under construction</span>
        <span class="text2">Check back later!</span>
    </div>
</section>
