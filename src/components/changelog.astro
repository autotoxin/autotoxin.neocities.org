---
import "../styles/features/changelog.css";
import { Content } from "../content/changelog.md";
import { cn } from "../utils/cn";

interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn("changelog flex flex-col justify-start gap-2", className)} role="log">
    <h3 class="min-h-0 text-center text-xl leading-none">Changelog</h3>
    <div class="min-h-0 overflow-auto overscroll-y-contain">
        <div><Content /></div>
    </div>
</div>
