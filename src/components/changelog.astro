---
// styles
import "../styles/features/changelog.css";

// content
import { Content } from "../content/changelog.md";

// utils
import { cn } from "../utils/cn";

interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<section class={cn("changelog flex flex-col justify-start gap-2", className)}>
    <h3 class="min-h-0 text-center text-xl leading-none">Changelog</h3>
    <div class="min-h-0 overflow-auto overscroll-y-contain">
        <div><Content /></div>
    </div>
</section>
