---
// styles
import "../styles/features/view-counter.css";

// utils
import { v4 as uuidv4 } from "uuid";

const MAX_DIGITS = 7;
const ANIMATION_DURATION = 1000; // ms
const REFRESH_RATE = 25; // ms

const getEndpointUrl = (url: string) => {
    if (url.includes("neocities")) {
        const sitename = url.split(".")[0];
        return `https://weirdscifi.ratiosemper.com/neocities.php?sitename=${sitename}`;
    }
    return `https://nekoweb.org/api/site/info/${url}`;
};

const url = Astro.url.hostname !== "localhost" ? Astro.url.hostname : Astro.site?.hostname;
const endpointUrl = url && getEndpointUrl(url);

// if we can't determine the endpoint URL, don't render the counter at all
if (!endpointUrl) return;

// use a unique id to prevent conflicts if multiple counters are rendered on the same page
const counterId = `vc-${uuidv4()}`;
---

<section class="flex flex-col items-center gap-1">
    <h4 class="text-secondary bg-background rounded-pixelated-2 px-1 py-0.5 leading-none">you are visitor</h4>
    <div id={counterId} class="view-counter">
        {Array.from({ length: MAX_DIGITS }).map(() => <span>?</span>)}
    </div>
    <div class="text-primary bg-background rounded-pixelated-2 px-1 py-0.5 leading-none">thank you!</div>
</section>

<script is:inline define:vars={{ url, counterId, endpointUrl, MAX_DIGITS, ANIMATION_DURATION, REFRESH_RATE }}>
    const padNumber = (num, size) => {
        let padNum = num.toString();
        while (padNum.length < size) {
            padNum = "0" + padNum;
        }
        return padNum;
    };

    const startNumberAnimation = (element, finalValue, duration) => {
        // do not animate if user prefers reduced motion
        const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
        if (motionQuery.matches) {
            element.textContent = finalValue;
            return;
        }

        const refreshRate = REFRESH_RATE;
        let startTime;
        const animate = (timestamp) => {
            if (!startTime) startTime = timestamp;
            const elapsed = timestamp - startTime;

            if (elapsed < duration) {
                element.textContent = Math.floor(Math.random() * 10);
                setTimeout(() => {
                    requestAnimationFrame(animate);
                }, refreshRate);
            } else {
                element.textContent = finalValue;
            }
        };
        requestAnimationFrame(animate);
    };

    const loadVisitsCounter = async () => {
        try {
            const counterContainer = document.getElementById(counterId);
            const { views } = await (await fetch(endpointUrl)).json();

            const counterNumbers = counterContainer.querySelectorAll("span");
            // this will never happen lol
            if (views + 1 > Math.pow(10, MAX_DIGITS) - 1) {
                console.warn("View count exceeds display limit");
                counterNumbers.forEach((number, idx) => {
                    startNumberAnimation(number, "?", ANIMATION_DURATION + idx * 150);
                });
                return;
            }

            const digits = padNumber(views + 1, MAX_DIGITS).split("");
            counterNumbers.forEach((number, idx) => {
                startNumberAnimation(number, digits[idx], ANIMATION_DURATION + idx * 150);
            });
        } catch (error) {
            console.error("Error fetching view count:", error);
        }
    };
    loadVisitsCounter();
</script>
