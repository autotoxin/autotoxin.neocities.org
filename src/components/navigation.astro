---
// components
import NavItem, { type NavItem as NavItemType } from "./nav-item.astro";

interface Props {
    class?: string;
    menuItems: NavItemType[];
}

const { class: className, menuItems = [] } = Astro.props;
---

<nav class={`bg-background rounded-pixelated-6 flex grow flex-col justify-start p-5 ${className}`}>
    <header class="cursor-default text-center text-xl select-none">Navigation</header>
    <ul class="side-menu grow">
        {menuItems.map((item) => <NavItem item={item} />)}
    </ul>
</nav>
